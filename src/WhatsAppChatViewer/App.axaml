    <StreamGeometry x:Key="FullscreenExitIcon">M9,4 L9,9 L4,9 M20,9 L15,9 L15,4 M15,20 L15,15 L20,15 M4,15 L9,15 L9,20</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#E9EDEF" />
      <Setter Property="Foreground" Value="#111B21" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="19" />
    </Style>
    <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A3942" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
